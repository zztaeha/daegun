# Indic syllables: the three patterns of Microsoft's Devanagari specification ("Find next syllable"), with what its
# own text and Unicode's Indic properties add, each noted where it's used. Numbers are categories.py's.

categories:
  X            = 0
  C            = 1
  V            = 2
  N            = 3
  H            = 4
  ZWNJ         = 5
  ZWJ          = 6
  M            = 7
  SM           = 8
  A            = 9
  Placeholder  = 10
  DottedCircle = 11
  Ra           = 12
  Repha        = 13
  Medial       = 14
  Stacker      = 15
  Symbol       = 16
  MPost        = 17
  SMDigit      = 18

definitions:
  # The spec's C; Ra is told apart because it becomes a reph.
  consonant = C | Ra
  joiner = ZWJ | ZWNJ
  # The spec's [Ra+H], or a reph Unicode encodes as one character.
  reph = Ra H | Repha
  modifier = SM | SMDigit
  # The spec's C+[N]+<H+[<ZWNJ|ZWJ>]|<ZWNJ|ZWJ>+H>, but a ZWNJ after the halant ends the syllable: it "inhibits
  # connection", and fonts shape the next consonant on its own. A second N is a mark the table classes with nukta.
  half = consonant N? N? (H ZWJ? | joiner H)
  # The spec's {M}+[N]+[H]. Each matra may take a nukta, as the spec lets it; a joiner may stand before one, asking
  # for or keeping from a join; and Gurmukhi's bindi may come before its ii.
  matras = (joiner? (M | modifier? MPost) N?)+ H?
  # The spec's [SM]+[(VD)]; Tamil writes Grantha's candrabindu and visarga together, so two may stand, and a ZWNJ
  # after them keeps them from what follows.
  signs = (joiner? modifier modifier? ZWNJ?)? (A A?)?
  # After a base: Unicode's medial consonant, a closing halant or the matras, the signs, and a ZWJ ending it. A ZWNJ
  # anywhere else stands apart, as the spec has it.
  tail = Medial? (H joiner? | matras)? signs ZWJ?

syllables:
  # Order is priority where two match the same length. Unicode's repha or consonant with stacker may open a syllable.
  consonant_syllable = (Repha | Stacker)? half* consonant N? N? A? tail
  vowel_syllable     = reph? V N? ((joiner? H | ZWJ) consonant N?)? matras? signs ZWJ?
  # The spec's stand-alone cluster, the dotted circle a base like its NBSP: either shows a mark on its own.
  standalone_cluster = reph? (Placeholder | DottedCircle) (joiner? H consonant)? N? tail
  symbol_cluster     = Symbol N? signs ZWJ?
  # A modifier written as a digit, or a joiner, standing alone isn't a mark missing its base.
  non_indic_cluster  = SMDigit | joiner
  # Marks with no base, which the spec has a dotted circle carry.
  broken_cluster     = reph? N? tail
  non_indic_cluster  = any
