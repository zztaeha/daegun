# Khmer syllables: the order of Microsoft's Khmer specification ("Syllables beginning with consonants"), its class
# chart's classes, and what its own text adds, each noted where it's used. Numbers are categories.py's.

categories:
  C            = 1
  V            = 2
  H            = 4
  ZWNJ         = 5
  ZWJ          = 6
  Placeholder  = 10
  DottedCircle = 11
  Ra           = 12
  VPre         = 20
  VAbv         = 21
  VBlw         = 22
  VPst         = 23
  RegShift     = 24
  Robat        = 25
  AbvS         = 26
  PstS         = 27

definitions:
  # The spec's Cons and IndV; Ra is told apart because its subscript goes before the base.
  letter = C | Ra | V
  joiner = ZWJ | ZWNJ
  # The spec's {COENG + (Cons | IndV)}, its { } nought to two.
  subscripts = (H letter)? (H letter)?
  shift = joiner? RegShift
  # The spec's [PreV | BlwV] + [RegShift] + [AbvV] + {AbvS} + [PstV] + [PstS]. A split vowel reaches here as its
  # pre-base part, U+17C1, then the rest; Khmer writes am as aa then nikahit, so a sign above may follow the vowel.
  signs = (VPre | VBlw)? shift? (joiner? VPre? VAbv)? AbvS? AbvS? (VPre? VPst)? AbvS? PstS?
  # The robat follows its consonant; a register shifter, which changes the consonant's vowel, follows it or its
  # subscripts; text often types a subscript after the vowel; and a coeng may end a syllable with nothing under it.
  tail = Robat? shift? subscripts (H | shift? signs (H letter)?) joiner?

syllables:
  # Order is priority where two match the same length. The spec: "a syllable will begin with a Cons, IndV, or
  # Number", a number being the table's placeholder.
  consonant_syllable = (letter | Placeholder | DottedCircle) tail
  non_khmer_cluster  = joiner
  # Signs with no base, which the spec has a dotted circle carry.
  broken_cluster     = tail
  non_khmer_cluster  = any
