# Myanmar syllables: the clusters of Microsoft's Myanmar script development specification ("Well-formed Clusters"),
# with the spec's class names where the table's differ. Numbers are categories.py's.

categories:
  X            = 0
  C            = 1
  IV           = 2   # independent vowels, the table's V
  DB           = 3   # dot below, the table's N
  H            = 4
  ZWNJ         = 5
  ZWJ          = 6
  SM           = 8   # the spec's V: visarga and the Shan tones
  A            = 9
  GB           = 10  # generic bases and digits but zero, the table's Placeholder
  DottedCircle = 11
  Ra           = 12  # the letters a kinzi opens with
  VS           = 19
  VPre         = 20
  VAbv         = 21
  VBlw         = 22
  VPst         = 23
  As           = 28
  MY           = 29
  MR           = 30
  MW           = 31
  MH           = 32
  ML           = 33  # Mon's medial la, which the spec counts with MH
  PT           = 34

definitions:
  # The spec's <C | IV>; Ra is one where it opens no kinzi.
  letter = C | IV | Ra
  # The spec's K, "a special sequence of three characters".
  kinzi = Ra As H
  # (H <C | IV> [VS])*
  stacked = (H letter VS?)*
  # (As)* [MY [As]] [MR] [<MW [As] | [MW] MH [As]>]
  medials = As* (MY As?)? MR? (MW As? | MW? (MH | ML) As?)?
  # (VPre)* (VAbv)* (VBlw)* (A)* [DB [As]], then (VPst [MH] (As)* (VAbv)* (A)* [DB [As]])*. A selector may follow
  # a pre-base vowel too: Unicode standardizes the vowel sign e's dotted form as 1031 FE00.
  vowels = (VPre VS?)* VAbv* VBlw* A* (DB As?)? (VPst (MH | ML)? As* VAbv* A* (DB As?)?)*
  # (PT < [A] [DB] [As] | [As] [A] >)* (V)* [J]
  tones = (PT (A? DB? As? | As? A?))* SM* (ZWJ | ZWNJ)?

syllables:
  # The spec's cluster ending in a halant and its complex cluster, alike up to the halant; the dotted circle is one
  # of its generic bases.
  consonant_syllable  = kinzi? (letter | GB | DottedCircle) VS? stacked (H | medials vowels tones)
  # A joiner on its own is no combining mark, so it is a cluster as the spec's simple ones are.
  non_myanmar_cluster = ZWJ | ZWNJ
  # Combining marks with no base, which the spec has a dotted circle carry.
  broken_cluster      = kinzi? VS? stacked (H | medials vowels tones)
  non_myanmar_cluster = any
