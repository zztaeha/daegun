# Universal Shaping Engine clusters, from Microsoft's own specification.
#
#   https://learn.microsoft.com/en-us/typography/script-development/use
#
# Under "Cluster validation" that page publishes seven cluster patterns outright, with a notation
# legend and a class-derivation table mapping Unicode properties onto USE's classes. This grammar is
# those patterns in the notation gen-syllable-machines.py accepts:
#
#   1 Independent            < IND | O | Rsv | WJ > [VS]
#   2 Standard               [< R | CS >] < B | GB > [VS] (CMAbv)* (CMBlw)*
#                            (< H B [VS] | SUB > (CMAbv)* (CMBlw)*)*
#                            [MPre] [MAbv] [MBlw] [MPst]
#                            (VPre)* (VAbv)* (VBlw)* (VPst)*
#                            (VMPre)* (VMAbv)* (VMBlw)* (VMPst)*
#                            (FAbv)* (FBlw)* (FPst)* [FM]
#   3 Virama terminated      …the standard prefix… < H | RK >
#   4 Number-joiner term.    N [VS] (HN N [VS])* HN
#   5 Numeral                N [VS] (HN N [VS])*
#   6 Symbol                 < S | GB > [VS] (CMAbv)* (CMBlw)*
#   7 Hieroglyph             SB* G [VS] [HR] [HM] SE* ( J SB* G [VS] [HR] [HM] SE* )*
#
# **Four of the spec's classes do not survive into the table as themselves.** Each is a choice
# gen-use-table.py made, and each is noted where it is used:
#
#   - VS and ZWJ both arrive as CGJ, because all three are things a cluster carries without being
#     changed by them.
#   - IND, Rsv and S all arrive as O. The table has no SYM class of its own, so the spec's
#     `< S | GB >` symbol cluster reads `< O | GB >` here.
#   - The spec's single FM and SM are split by position, as its own subclass table does for the
#     others – FMAbv/FMBlw/FMPst and SMAbv/SMBlw.
#   - IS (invisible stacker), Sk (sakot) and HVM are not in the spec's class list at all. They are
#     overrides gen-use-table.py adds for Tai Tham and Sinhala, whose stackers are not viramas.
#
# The category numbers are read by gen-use-table.py to build USE_CATEGORIES, so they are an
# interface, not a free choice.

categories:
  O     = 0
  B     = 1
  N     = 4
  GB    = 5
  CGJ   = 6     # also carries the spec's VS and ZWJ
  SUB   = 11
  H     = 12
  HN    = 13
  ZWNJ  = 14
  WJ    = 16
  R     = 18
  VPre  = 22
  VMPre = 23
  FAbv  = 24
  FBlw  = 25
  FPst  = 26
  MAbv  = 27
  MBlw  = 28
  MPst  = 29
  MPre  = 30
  CMAbv = 31
  CMBlw = 32
  VAbv  = 33
  VBlw  = 34
  VPst  = 35
  VMAbv = 37
  VMBlw = 38
  VMPst = 39
  SMAbv = 41
  SMBlw = 42
  CS    = 43
  IS    = 44    # invisible stacker, an override: it stacks without being a virama
  FMAbv = 45
  FMBlw = 46
  FMPst = 47
  Sk    = 48    # Tai Tham's sakot, likewise
  G     = 49
  J     = 50
  SB    = 51
  SE    = 52
  HVM   = 53    # Sinhala's virama, which doubles as a vowel modifier
  HM    = 54
  HR    = 55
  RK    = 56

definitions:
  # The spec's `[VS]` appears nowhere below, and deliberately: `universal.rs::included` drops CGJ
  # before segmentation, which is the spec's own instruction – "CGJ has been omitted from the above
  # schema in order to avoid unnecessary complexity. It may occur anywhere in a cluster with no
  # effect." The table folds VS and ZWJ into CGJ, so all three are dropped the same way.

  # The spec's `[FM]`, split by position. One post-base modifier, or a run of above and below ones –
  # the split turns "at most one FM" into a shape the single class could not express.
  fm = FMAbv* FMBlw* | FMPst

  # `< B | GB >` – the only required part of a standard cluster.
  base = B | GB
  # `[< R | CS >]`
  prefix = (R | CS)?

  # `(CMAbv)* (CMBlw)*`
  cons_mods = CMAbv* CMBlw*
  # `(< H B [VS] | SUB > (CMAbv)* (CMBlw)*)*` – the spec stacks a BASE, not a BASE_OTHER, so a
  # halant followed by GB is not a stack and the cluster ends at the halant.
  # What may sit between a base and the one stacked under it. Either virama may be followed by a
  # sakot; the invisible stacker and a bare sakot stand alone. Nothing longer stacks.
  stacker = (H | HVM) Sk? | IS | Sk
  # A plain stack, which the cluster carries on from as if nothing happened.
  stacker_plain = H | IS | Sk | HVM
  stacked = ((stacker_plain B | SUB) cons_mods)*

  # `[MPre] [MAbv] [MBlw] [MPst]`
  medials = MPre? MAbv? MBlw? MPst?
  # `(VPre)* (VAbv)* (VBlw)* (VPst)*`
  vowels = VPre* VAbv* VBlw* VPst*
  # `(VMPre)* (VMAbv)* (VMBlw)* (VMPst)*`
  vowel_mods = VMPre* VMAbv* VMBlw* VMPst*
  # A run of symbol modifiers, which stands alone rather than attaching to a cluster's tail.
  sym_mods = SMAbv SMAbv* SMBlw* | SMBlw SMBlw*

  # `(FAbv)* (FBlw)* (FPst)* [FM]`
  finals = FAbv* FBlw* FPst* fm

  # Everything a standard cluster carries once its base and stack are settled. A visible virama or
  # Sinhala's HVM may precede it: the spec's `< H | RK >` terminator covers Virama *and*
  # Invisible_Stacker under one class, and the table separates them – the invisible one terminates,
  # the visible one is drawn and stays inside the cluster.
  # One or more vowels, and one or more vowel modifiers – spelled out because a sakot may only follow
  # something, and an all-optional run would let it follow nothing.
  v_run  = VPre VPre* VAbv* VBlw* VPst* | VAbv VAbv* VBlw* VPst* | VBlw VBlw* VPst* | VPst VPst*
  vm_run = VMPre VMPre* VMAbv* VMBlw* VMPst* | VMAbv VMAbv* VMBlw* VMPst* | VMBlw VMBlw* VMPst* | VMPst VMPst*

  # What a sakot may close. A drawn virama is **not** among them: `H Sk` is the stacker prefix above
  # waiting for a base, so nothing may follow it but that base.
  before_sakot = v_run HVM? vowel_mods | HVM vowel_mods | vm_run | H HVM vowel_mods | H HVM? vm_run

  # One or more medials, for the same reason `v_run` is spelled out.
  m_run = MPre MAbv? MBlw? MPst? | MAbv MBlw? MPst? | MBlw MPst? | MPst

  # A sakot closes a cluster that has something in it. With nothing before it, a sakot is a cluster on
  # its own – which is why the empty branch here carries no `Sk?`.
  # A sakot never has finals after it: it either stacks the next base or ends the cluster. So the two
  # shapes are kept apart rather than folded into one `Sk?`.
  tail_plain = finals | m_run finals | m_run dangling_halant finals | m_run before_sakot finals | dangling_halant finals | before_sakot finals
  # Everything a sakot may close, when something precedes it.
  sakot_prefix = m_run before_sakot? | m_run (H | HVM) | before_sakot
  tail_sakot = sakot_prefix Sk
  # A stack reached *through* a sakot is terminal: after it only the finals and another such stack
  # follow, never more medials or vowels. That is what separates `Sk B` – a plain stack – from
  # `H Sk B`, which ends the cluster's structure and leaves only its finals.
  sakot_entry = (H | HVM | sakot_prefix) Sk
  sakot_stack = sakot_entry B (Sk B)* (Sk | finals)
  # Every shape that ends on a sakot, so one production can name them all.
  sakot_ending = ((H | HVM)? | sakot_prefix) Sk | sakot_entry B (Sk B)* Sk

  after_stack = tail_plain | tail_sakot | sakot_stack

  # A halant with no base after it cannot be a stack, so the cluster ends there – but it is still a
  # drawn virama inside the cluster, not a terminator, and what may follow is only what comes after
  # the vowels.
  dangling_halant = H HVM? vowel_mods

  # The shared opening of patterns 2 and 3.
  cluster_head = prefix base cons_mods stacked

  # Everything that may follow a head, whichever way the cluster ends. The trailing non-joiner is the
  # spec's own rule, stated in prose rather than in the patterns: "the zero-width non-joiner ...
  # continues a preceding cluster but causes a cluster break after itself when the following
  # character is not a mark character".
  # A cluster may also end on a stacker with no base under it, which is the `H`, `H Sk`, `IS` and
  # `Sk` shapes – terminal, so nothing follows them.
  after_head = cons_mods stacked (stacker | RK | after_stack) ZWNJ?

  # `SB* G [VS] [HR] [HM] SE*` – one hieroglyph with its modifiers and segment brackets.
  hieroglyph = SB* G HR? HM? SE*

syllables:
  # Order is priority: where two match the same length, the first listed wins.
  virama_terminated_cluster        = cluster_head (IS | RK) ZWNJ?
  # A sakot ends the cluster, so this is the standard shape stopped at the sakot with no finals after
  # it. Listed above the standard cluster, so when both match the same length this one names it.
  sakot_terminated_cluster         = cluster_head sakot_ending ZWNJ?
  standard_cluster                 = cluster_head (stacker | after_stack) ZWNJ?
  number_joiner_terminated_cluster = N (HN N)* HN ZWNJ?
  numeral_cluster                  = N (HN N)* ZWNJ?
  # The spec's `< S | GB >`, with S arriving as O. A symbol head carries the same tail a base does,
  # plus the symbol modifiers – which is what sends `GB SMAbv` here rather than to the standard
  # cluster listed above it.
  # The spec's `< S | GB > [VS] (CMAbv)* (CMBlw)*`, with S arriving as O. The symbol modifiers attach
  # to the head itself, not to a stack – so a symbol head takes either them or an ordinary tail.
  symbol_cluster                   = (O | GB | SB) (sym_mods ZWNJ? | after_head)
  # The trailing joiner is the spec's own allowance: "implementations should support a Hieroglyph
  # cluster terminated by a joiner so the cluster is valid prior to input of a following HIEROGLYPH
  # character".
  hieroglyph_cluster               = hieroglyph (J (J | SB)* hieroglyph)* (J (J | SB)*)? ZWNJ?
  # A lone post-base final modifier is a cluster, not a broken one. The class is reached only by the
  # digit-shaped syllable modifiers – the superscripts and subscripts two, three and four – which are
  # not marks and have nothing to attach to, so a dotted circle in front would invent a base for
  # something that never wanted one. Listed above `broken_cluster`, which also matches it, and one
  # character long either way – so the order is what decides it.
  non_cluster                      = FMPst
  # Not in the spec, and required by it: "when a cluster starts with any character that has UGC=Mc or
  # UGC=Mn, USE inserts a dotted circle glyph to indicate a broken cluster". This is that case – the
  # cluster's tail with no base to carry it.
  # A dangling halant is its own broken shape: the spec stacks `H B`, so an H with no base after it
  # cannot be a stack, and what may still follow is only what comes after the vowels.
  broken_cluster                   = R? (ZWNJ | Sk ZWNJ? | HN (N HN)* N? ZWNJ? | sym_mods ZWNJ? | after_head)
  # The spec's independent cluster, plus everything that reaches the shaper matching nothing at all.
  non_cluster                      = any
